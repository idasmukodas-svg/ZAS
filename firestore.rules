rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userDocPath());
    }

    function userRole() {
      return hasUserProfile() ? get(userDocPath()).data.role : "";
    }

    function isSuperAdmin() {
      return userRole() == "super_admin";
    }

    function isAdminPelatih() {
      return userRole() == "admin_pelatih";
    }

    function isPelatih() {
      return userRole() == "pelatih";
    }

    function isOrangTua() {
      return userRole() == "orang_tua";
    }

    function isAssignedToClass(classId) {
      return hasUserProfile() &&
        classId is string &&
        (
          (
            get(userDocPath()).data.assigned_classes is list &&
            classId in get(userDocPath()).data.assigned_classes
          ) ||
          (
            exists(/databases/$(database)/documents/classes/$(classId)) &&
            get(/databases/$(database)/documents/classes/$(classId)).data.coach_uids is list &&
            request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.coach_uids
          )
        );
    }

    function isLinkedParticipant(participantId) {
      return hasUserProfile() &&
        participantId is string &&
        (
          (
            get(userDocPath()).data.linked_participants is list &&
            participantId in get(userDocPath()).data.linked_participants
          ) ||
          (
            exists(/databases/$(database)/documents/participants/$(participantId)) &&
            get(/databases/$(database)/documents/participants/$(participantId)).data.parent_uid == request.auth.uid
          )
        );
    }

    function hasActiveSessionForClass(classId, sessionId) {
      return classId is string &&
        sessionId is string &&
        exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)) &&
        get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.class_id == classId &&
        get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.status_sesi == "aktif";
    }

    // ------------------------------------------------------------------------
    // 1. USERS: Profil Akun, Role, Penugasan Kelas & Pelatih
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isAdminPelatih() ||
        isPelatih()
      );

      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == "orang_tua"
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role
        )
      );

      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // 3. PARTICIPANTS: Database Atlet
    // ------------------------------------------------------------------------
    match /participants/{participantId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        isPelatih() ||
        isLinkedParticipant(participantId) ||
        (resource != null && resource.data.parent_uid == request.auth.uid)
      );

      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (
          request.resource.data.parent_uid == request.auth.uid &&
          request.resource.data.status_keanggotaan == "pending_verifikasi"
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (isPelatih() && isAssignedToClass(resource.data.class_id))
      );

      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // 2. CLASSES: Data Kelas Renang & Pelatih Pengampu
    // ------------------------------------------------------------------------
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isSuperAdmin() || isAdminPelatih());
    }

    // ------------------------------------------------------------------------
    // 3. PARTICIPANTS: Database Atlet & Siswa
    // ------------------------------------------------------------------------
    match /participants/{participantId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        isPelatih() ||
        isLinkedParticipant(participantId) ||
        (resource.data.parent_uid == request.auth.uid)
      );

      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (
          isOrangTua() &&
          request.resource.data.parent_uid == request.auth.uid &&
          request.resource.data.status_keanggotaan == "pending_verifikasi"
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (isPelatih() && isAssignedToClass(resource.data.class_id))
      );

      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // 4. ATTENDANCE_SESSIONS: Sesi Absensi Harian (PIN 4 Digit & QR)
    // ------------------------------------------------------------------------
    match /attendance_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (isPelatih() && isAssignedToClass(request.resource.data.class_id))
      );
      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // 5. ATTENDANCES: Daftar Hadir Siswa / Peserta
    // ------------------------------------------------------------------------
    match /attendances/{attendanceId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (isPelatih() && isAssignedToClass(resource.data.class_id)) ||
        (isOrangTua() && isLinkedParticipant(resource.data.participant_id))
      );

      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (isPelatih() && isAssignedToClass(request.resource.data.class_id)) ||
        (
          isOrangTua() &&
          isLinkedParticipant(request.resource.data.participant_id) &&
          request.resource.data.diinput_oleh_uid == request.auth.uid &&
          request.resource.data.kategori in ["atlet", "siswa"] &&
          request.resource.data.diverifikasi_pelatih == false &&
          (
            (
              request.resource.data.status_kehadiran == "hadir" &&
              hasActiveSessionForClass(request.resource.data.class_id, request.resource.data.session_id)
            ) ||
            request.resource.data.status_kehadiran in ["izin", "sakit"]
          )
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (isPelatih() && isAssignedToClass(resource.data.class_id))
      );

      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // 6. COACH_ATTENDANCES: Daftar Hadir Pelatih (Penggajihan)
    // ------------------------------------------------------------------------
    match /coach_attendances/{coachAttendanceId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isAdminPelatih() || isPelatih());
      allow create, update: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (isPelatih() && request.resource.data.coach_uid == request.auth.uid)
      );
      allow delete: if isSuperAdmin();
    }

    // ------------------------------------------------------------------------
    // 7. TRAINING_PROGRAMS: Program Latihan Kelas
    // ------------------------------------------------------------------------
    match /training_programs/{programId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        isSuperAdmin() ||
        isAdminPelatih() ||
        (isPelatih() && isAssignedToClass(request.resource.data.class_id))
      );
      allow delete: if isSuperAdmin();
    }
  }
}
